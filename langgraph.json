{
  "dependencies": ["."],
  "graphs": {
    "chat_agent": "./src/rag_agent/graphs/chat_agent.py:chat_agent"
  },
  "env": ".env",
  "http": {
    "app": "./api/main.py:app",
    "cors": {
      "allow_origins": [
        "http://localhost:3000",
        "http://localhost:4000",
        "http://localhost:4040",
        "http://127.0.0.1:3000",
        "http://127.0.0.1:4000",
        "http://127.0.0.1:4040"
      ],
      "allow_methods": ["*"],
      "allow_headers": ["*"],
      "allow_credentials": true,
      "expose_headers": [
        "x-pagination-total",
        "x-pagination-next",
        "content-location"
      ]
    }
  }
}
