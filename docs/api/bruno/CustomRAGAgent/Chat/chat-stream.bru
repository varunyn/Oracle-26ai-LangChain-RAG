meta {
  name: Chat Stream
  type: http
  seq: 2
}

post {
  url: {{langgraphBaseUrl}}/threads/{{threadId}}/runs/stream
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "assistant_id": "chat_agent",
    "input": {
      "messages": [
        {
          "role": "user",
          "content": "Explain the current RAG workflow."
        }
      ],
      "context": {
        "model_id": "{{defaultModel}}",
        "mode": "rag",
        "session_id": "{{sessionId}}",
        "collection_name": "{{defaultCollection}}",
        "enable_reranker": true,
        "enable_tracing": false
      }
    },
    "stream_mode": [
      "values",
      "messages",
      "tools"
    ]
  }
}
