meta {
  name: Thread History
  type: http
  seq: 7
}

post {
  url: {{langgraphBaseUrl}}/threads/search
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "limit": 20,
    "sort_by": "updated_at",
    "sort_order": "desc",
    "select": ["thread_id", "created_at", "updated_at", "values"]
  }
}
