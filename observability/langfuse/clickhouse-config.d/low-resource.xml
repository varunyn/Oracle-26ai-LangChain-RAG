<clickhouse>
  <!-- Local laptop defaults: Langfuse does not need ClickHouse's verbose internal logs. -->
  <logger>
    <level>warning</level>
    <size>100M</size>
    <count>3</count>
  </logger>

  <!-- Avoid background system-log churn and disk growth in local self-hosted Langfuse. -->
  <query_log remove="1" />
  <query_thread_log remove="1" />
  <query_views_log remove="1" />
  <trace_log remove="1" />
  <text_log remove="1" />
  <metric_log remove="1" />
  <asynchronous_metric_log remove="1" />
  <opentelemetry_span_log remove="1" />
  <processors_profile_log remove="1" />
  <query_metric_log remove="1" />
  <part_log remove="1" />
  <crash_log remove="1" />
</clickhouse>
