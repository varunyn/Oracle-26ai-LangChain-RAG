<clickhouse>
  <!-- Work around a ClickHouse 26.6 analyzer bug in Langfuse's scores.all
       aggregate predicate; Langfuse migrations do not require the analyzer. -->
  <profiles>
    <default>
      <enable_analyzer>0</enable_analyzer>
    </default>
    <clickhouse>
      <enable_analyzer>0</enable_analyzer>
    </clickhouse>
  </profiles>

  <!-- Local laptop defaults: Langfuse does not need ClickHouse's verbose internal logs. -->
  <logger>
    <level>warning</level>
    <size>100M</size>
    <count>3</count>
  </logger>

  <!-- Avoid background system-log churn and disk growth in local self-hosted Langfuse. -->
  <query_log remove="1" />
  <query_thread_log remove="1" />
  <query_views_log remove="1" />
  <query_metric_log remove="1" />
  <trace_log remove="1" />
  <text_log remove="1" />
  <metric_log remove="1" />
  <asynchronous_metric_log remove="1" />
  <asynchronous_insert_log remove="1" />
  <background_schedule_pool_log remove="1" />
  <error_log remove="1" />
  <histogram_metric_log remove="1" />
  <opentelemetry_span_log remove="1" />
  <processors_profile_log remove="1" />
  <part_log remove="1" />
  <crash_log remove="1" />
</clickhouse>
