# Browser-visible API base for direct frontend->backend calls (e.g. /api/config).
NEXT_PUBLIC_API_BASE=http://localhost:2024
# Browser-visible LangGraph Agent Server base for chat streams.
NEXT_PUBLIC_LANGGRAPH_API_BASE=http://localhost:2024
# Server-only Agent Server base used by Next.js rewrites and server-side code.
LANGGRAPH_BACKEND_URL=http://localhost:2024
# Server-only product API base used by Next.js /api/* rewrites and server-side bootstrap calls.
FASTAPI_BACKEND_URL=http://localhost:2024

# Default flow mode in the UI: rag | mcp | mixed | direct (optional; default is mixed)
NEXT_PUBLIC_DEFAULT_FLOW_MODE=mixed
