# Browser API base for direct frontend->backend calls (recommended for no /api proxy)
NEXT_PUBLIC_API_BASE=http://localhost:2024
# Browser chat stream base for direct frontend->LangGraph Agent Server calls
NEXT_PUBLIC_LANGGRAPH_API_BASE=http://localhost:2024
# Server-only Agent Server base used by Next rewrites and server-side code
LANGGRAPH_BACKEND_URL=http://localhost:2024

# Default flow mode in the UI: rag | mcp | mixed | direct (optional; default is mixed)
NEXT_PUBLIC_DEFAULT_FLOW_MODE=mixed
